{
  "name": "stickerface",
  "version": "0.1.0",
  "private": true,
  "description": "Hide faces in a photo with an emoji sticker — entirely in the browser, no build step, nothing uploaded.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "e2e": "bash scripts/e2e.sh",
    "e2e:mobile": "bash scripts/e2e-mobile.sh",
    "fixture": "python3 scripts/make-fixture.py",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvasilev/stickerface.git"
  },
  "homepage": "https://rvasilev.github.io/stickerface/",
  "keywords": [
    "face-blur",
    "privacy",
    "emoji",
    "canvas",
    "static-site",
    "no-backend"
  ],
  "license": "MIT"
}
